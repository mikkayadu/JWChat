# Required for Gemini generation + embeddings
GEMINI_API_KEY=your_gemini_key

# Pinecone
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX=website-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Model settings
CHAT_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768

# Chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Optional (Celery)
REDIS_URL=redis://localhost:6379/0

# Advanced retrieval (all optional — defaults shown)
USE_HYBRID_SEARCH=true       # Enable BM25 sparse-dense fusion on retrieval results
USE_RERANKING=true           # Enable cross-encoder reranking (bge-reranker-v2-m3)
USE_HYDE=false               # Enable HyDE query-to-passage transformation
USE_MULTI_QUERY=false        # Enable LLM query expansion (3 variants + original)
RETRIEVAL_MIN_SCORE=0.5      # Drop Pinecone matches below this cosine similarity (0.5–0.65 suits most embedding models)
RETRIEVAL_K=20               # How many candidates to fetch before reranking
RERANK_TOP_N=5               # How many docs to keep after reranking
BM25_HYBRID_ALPHA=0.6        # Dense score weight in fusion (0=BM25 only, 1=dense only)
