# Required for Gemini generation + embeddings
GEMINI_API_KEY=your_gemini_key

# Pinecone
PINECONE_API_KEY=your_pinecone_key
PINECONE_INDEX=website-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Model settings
# Provider backends are pluggable (see api/services/providers). To add a new
# backend, register it under a name and select it here — no service code changes.
LLM_PROVIDER=google           # Primary chat-model backend (registered: google, ollama)
EMBEDDINGS_PROVIDER=google    # Which embeddings backend to use (registered: google)
CHAT_MODEL=gemini-2.5-flash   # Leave unset to use the provider's default (e.g. qwen2.5:1.5b for ollama)
# IMPORTANT: the query embedding model MUST match the model your Pinecone vectors
# were ingested with — different models produce incompatible vector spaces. If you
# change this, re-ingest your content (older models like text-embedding-004 and
# embedding-001 have been shut down by Google).
EMBEDDING_MODEL=models/gemini-embedding-001
EMBEDDING_DIMENSIONS=768      # gemini-embedding-001 supports 768; keeps the index small

# Fallback chain — an ORDERED, comma-separated list of "provider:model" entries,
# each tried in turn when the one before it fails for any reason (rate
# limit/quota, timeout, 5xx, network). Leave empty to disable fallback.
# Each entry is split on the FIRST colon, so model names with ':' work too
# (e.g. ollama qwen2.5:1.5b). A bare "provider" uses that provider's default.
# Recommended all-free, all-fast setup: Gemini Flash primary, then Groq models,
# then local Ollama as the last resort.

FALLBACKS=groq:openai/gpt-oss-20b,ollama:qwen2.5:1.5b
# (legacy single-fallback form, still honoured only when FALLBACKS is unset:)
# FALLBACK_LLM_PROVIDER=ollama
# FALLBACK_CHAT_MODEL=qwen2.5:1.5b

# Intent classification (greeting / out-of-domain routing) uses its OWN
# provider/fallback chain, independent of LLM_PROVIDER above. This matters
# because classification needs reliable instruction-following on a nuanced
# multi-criteria prompt — small/local models often mis-score legitimate
# in-domain questions as out-of-domain. Defaults to Gemini if unset.
INTENT_LLM_PROVIDER=google
# INTENT_CHAT_MODEL=gemini-2.5-flash   # leave unset to use google's default
# Only models with reliable tool-calling belong here: the classifier runs through
# with_structured_output, and openai/gpt-oss-20b fails it ("tool_use_failed").
INTENT_FALLBACKS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b
# NOTE: do not set a global CHAT_MODEL when LLM_PROVIDER and INTENT_LLM_PROVIDER
# differ — CHAT_MODEL is shared by the google/ollama provider builders and will
# leak into whichever of them you use for intent classification. Use the
# provider-specific override instead (e.g. GROQ_CHAT_MODEL, INTENT_CHAT_MODEL).

# Groq — fast, free-tier hosted open models (used when a FALLBACKS entry names
# 'groq', or LLM_PROVIDER=groq). Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_key

# Ollama endpoint (used by the ollama provider, primary or fallback). Requires a
# running Ollama daemon with the model pulled, e.g.:  ollama pull qwen2.5:1.5b
# On CPU-only hosts prefer a small model (qwen2.5:1.5b) and keep USE_ENSEMBLE /
# USE_MULTI_QUERY / USE_HYDE off — each adds extra (slow) LLM calls per query.
OLLAMA_BASE_URL=http://localhost:11434

# Chunking
CHUNK_SIZE=400
CHUNK_OVERLAP=80

# Optional (Celery)
REDIS_URL=redis://localhost:6379/0

# Advanced retrieval (all optional — defaults shown)
USE_HYBRID_SEARCH=true       # Enable BM25 sparse-dense fusion on retrieval results
USE_RERANKING=true           # Enable cross-encoder reranking (bge-reranker-v2-m3)
USE_HYDE=false               # Enable HyDE query-to-passage transformation
USE_MULTI_QUERY=false        # Enable LLM query expansion (3 variants + original)
RETRIEVAL_MIN_SCORE=0.5      # Drop Pinecone matches below this cosine similarity (0.5–0.65 suits most embedding models)
RETRIEVAL_K=20               # How many candidates to fetch before reranking
RERANK_TOP_N=5               # How many docs to keep after reranking
BM25_HYBRID_ALPHA=0.6        # Dense score weight in fusion (0=BM25 only, 1=dense only)

# Ensemble reasoning (all optional — defaults shown)
USE_ENSEMBLE=false              # Enable multi-strategy ensemble reasoning for answers
ENSEMBLE_STRATEGIES=standard,cot,tot  # Comma-separated strategy names (see STRATEGY_MAP)
ENSEMBLE_SIMILARITY_THRESHOLD=0.85    # Cosine similarity threshold for answer clustering
ENSEMBLE_SHOW_METADATA=false          # Include ensemble metadata (winner, votes, timing) in API response
